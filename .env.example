# NIE Idea Vault Environment Configuration
# Copy this file to .env and adjust variables as needed

# Backend API Configuration
PORT=5000
HOST=0.0.0.0
API_BASE=http://localhost:5000
ENVIRONMENT=development

# CORS Configuration (comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5500,http://localhost:8080

# Mock Mode (set to true to run frontend with internal mock data)
USE_MOCK=true

# Database (optional for full backend)
DATABASE_URL=sqlite:///./ideavault.db

# JWT & Security (placeholders for production backend)
JWT_SECRET=replace_with_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
